name: "fraud_lightgbm"
backend: "fil"
default_model_filename: "lightgbm.txt"
max_batch_size: 4096

input [
  {
    name: "input__0"
    data_type: TYPE_FP32
    dims: [8]
  }
]

output [
  {
    name: "output__0"
    data_type: TYPE_FP32
    dims: [1]
  }
]

instance_group [{ kind: KIND_AUTO }]

parameters [
  {
    key: "model_type"
    value: { string_value: "lightgbm" }
  },
  {
    key: "is_classifier"
    value: { string_value: "true" }
  },
  {
    key: "predict_proba"
    value: { string_value: "true" }
  },
  {
    key: "threshold"
    value: { string_value: "0.5" }
  }
]

dynamic_batching {
  preferred_batch_size: [32, 128, 512]
  max_queue_delay_microseconds: 500
}
